---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, any> | Record<string, any>[];
  ogType?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  schema,
  ogType = 'website'
} = Astro.props;

const canonicalUrl = canonical.endsWith('/') ? canonical : `${canonical}/`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta http-equiv="refresh" content="0; url=https://busfirms.com/virginia/military-troop-transport/">
  <script>window.location.replace("https://busfirms.com/virginia/military-troop-transport/");</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="canonical" href={canonicalUrl}>
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="CharterBus VA - Military &amp; DoD Logistics Dispatch">

  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(schema) ? { "@context": "https://schema.org", "@graph": schema } : schema)} />
  )}
</head>
<body class="bg-white text-slate-900 antialiased selection:bg-emerald-700 selection:text-white">
  <!-- Military Dispatch Ribbon -->
  <div class="bg-slate-950 border-b border-slate-800 text-slate-300 text-xs py-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          VIRGINIA MILITARY LOGISTICS DESK
        </span>
        <span class="text-slate-400">DoD Troop Movements, Base-to-Base Transfers &amp; Defense Shuttles</span>
      </div>
      <div class="flex items-center gap-4 text-xs font-mono">
        <span>Military Desk: <a href="tel:+15712762316" class="text-emerald-400 hover:text-emerald-300 font-bold">(571) 276-2316</a></span>
        <span class="text-slate-600">|</span>
        <span class="text-slate-400">GSA Schedule Billing</span>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-emerald-950 text-emerald-300 flex items-center justify-center font-extrabold text-xl shadow-md border border-emerald-800">
          VA
        </div>
        <div>
          <div class="font-extrabold text-xl tracking-tight text-slate-900 flex items-center gap-1.5 leading-none">
            CharterBus <span class="text-emerald-700 text-xs font-mono font-bold uppercase tracking-wider px-1.5 py-0.5 bg-emerald-50 border border-emerald-200/60 rounded">Defense</span>
          </div>
          <p class="text-xs text-slate-500 mt-1 font-medium">Virginia Military &amp; DoD Installation Dispatch</p>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
        <a href="#installations" class="hover:text-emerald-700 transition-colors">Installations</a>
        <a href="#calculator" class="hover:text-emerald-700 transition-colors">Troop Estimator</a>
        <a href="#operators" class="hover:text-emerald-700 transition-colors">DoD Operator</a>
        <a href="#fleet" class="hover:text-emerald-700 transition-colors">Tactical Fleet</a>
        <a href="#faq" class="hover:text-emerald-700 transition-colors">Base Access FAQ</a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="tel:+15712762316" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white font-semibold text-sm shadow-sm transition-all">
          (571) 276-2316
        </a>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="bg-slate-950 text-slate-400 py-16 border-t border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-900 flex items-center justify-center text-white font-black text-sm">
              VA
            </div>
            <span class="font-bold text-white text-lg">CharterBus VA Defense</span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            DoD-compliant military troop transports, installation transfers, and defense personnel logistics across Virginia.
          </p>
          <p class="text-xs font-mono text-slate-500">
            Military Logistics Desk: <a href="tel:+15712762316" class="text-emerald-400 hover:underline">(571) 276-2316</a>
          </p>
        </div>

        <div>
          <h4 class="text-white font-bold text-sm tracking-wider uppercase font-mono mb-4">Virginia Commands</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="#installations" class="hover:text-emerald-400 transition-colors">Naval Station Norfolk &amp; Oceana</a></li>
            <li><a href="#installations" class="hover:text-emerald-400 transition-colors">Marine Corps Base Quantico</a></li>
            <li><a href="#installations" class="hover:text-emerald-400 transition-colors">Fort Belvoir &amp; Pentagon Logistics</a></li>
            <li><a href="#installations" class="hover:text-emerald-400 transition-colors">Joint Base Langley-Eustis</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-bold text-sm tracking-wider uppercase font-mono mb-4">CharterBus Network</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="https://charterbus.onrender.com" class="hover:text-emerald-400 transition-colors">&larr; National Faith Parent Hub</a></li>
            <li><a href="https://charterbusdc.onrender.com" class="hover:text-emerald-400 transition-colors">Washington DC Diplomatic &rarr;</a></li>
            <li><a href="https://charterbusmd.onrender.com" class="hover:text-emerald-400 transition-colors">Maryland Casino Shuttles &rarr;</a></li>
            <li><a href="/operators/vip-charter-bus-rentals/" class="text-emerald-400 hover:underline">VIP DoD Operator Profile &rarr;</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-bold text-sm tracking-wider uppercase font-mono mb-4">Security &amp; Compliance</h4>
          <p class="text-sm text-slate-400 mb-3">
            GSA schedule compliant billing, REAL ID drivers, installation gate entry vetting, and oversized pass-through ruck gear bays.
          </p>
          <div class="p-3 rounded bg-slate-900 border border-slate-800 text-xs font-mono text-slate-300">
            Direct Military Line:<br>
            <span class="text-emerald-400 font-bold">(571) 276-2316</span>
          </div>
        </div>
      </div>

      <div class="border-t border-slate-900 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <p>&copy; {new Date().getFullYear()} CharterBus Virginia Defense. All rights reserved.</p>
        <div class="flex items-center gap-6">
          <a href="/operators/vip-charter-bus-rentals/" class="hover:text-slate-400">DoD Defense Operator</a>
          <span>&bull;</span>
          <span>FMCSA &bull; Military Approved</span>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
