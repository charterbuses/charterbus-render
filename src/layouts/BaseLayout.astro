---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, any> | Record<string, any>[];
  ogType?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  schema,
  ogType = 'website'
} = Astro.props;

const canonicalUrl = canonical.endsWith('/') ? canonical : `${canonical}/`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta http-equiv="refresh" content="0; url=https://busfirms.com/faith-groups/church-youth-retreats/">
  <script>window.location.replace("https://busfirms.com/faith-groups/church-youth-retreats/");</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="canonical" href={canonicalUrl}>
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <!-- Font Preconnect & Stylesheets -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="CharterBus - National Faith-Based &amp; Church Group Transportation">

  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(schema) ? { "@context": "https://schema.org", "@graph": schema } : schema)} />
  )}
</head>
<body class="bg-white text-slate-900 antialiased selection:bg-amber-600 selection:text-white">
  <!-- Top Dispatch Ribbon -->
  <div class="bg-slate-900 border-b border-slate-800 text-slate-300 text-xs py-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
          NATIONAL MINISTRY NETWORK
        </span>
        <span class="text-slate-400">Faith-Based Group Transportation &amp; Multi-State Church Charters</span>
      </div>
      <div class="flex items-center gap-4 text-xs font-mono">
        <span>Ministry Dispatch: <a href="tel:+15712762316" class="text-amber-400 hover:text-amber-300 font-bold">(571) 276-2316</a></span>
        <span class="text-slate-600">|</span>
        <span class="text-slate-400">24/7 Group Support</span>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-slate-900 to-amber-700 flex items-center justify-center text-white font-extrabold text-xl shadow-md group-hover:scale-105 transition-transform duration-200">
          CB
        </div>
        <div>
          <div class="font-extrabold text-xl tracking-tight text-slate-900 flex items-center gap-1.5 leading-none">
            CharterBus <span class="text-amber-600 text-xs font-mono font-bold uppercase tracking-wider px-1.5 py-0.5 bg-amber-50 border border-amber-200/60 rounded">Faith</span>
          </div>
          <p class="text-xs text-slate-500 mt-1 font-medium">National Ministry &amp; Church Bus Dispatch</p>
        </div>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
        <a href="#divisions" class="hover:text-amber-700 transition-colors">Regional Divisions</a>
        <a href="#ministries" class="hover:text-amber-700 transition-colors">Ministry Services</a>
        <a href="#calculator" class="hover:text-amber-700 transition-colors">Cost Calculator</a>
        <a href="#fleet" class="hover:text-amber-700 transition-colors">Fleet Specifications</a>
        <a href="#faq" class="hover:text-amber-700 transition-colors">FAQ</a>
      </nav>

      <!-- CTA -->
      <div class="flex items-center gap-3">
        <a href="tel:+15712762316" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-semibold text-sm shadow-sm transition-all duration-200 hover:shadow-md">
          (571) 276-2316
        </a>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-slate-950 text-slate-400 py-16 border-t border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-amber-600 flex items-center justify-center text-white font-black text-sm">
              CB
            </div>
            <span class="font-bold text-white text-lg">CharterBus Faith Network</span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            Centralized coordination for church retreats, youth ministry camps, choir tours, and faith-based conventions across the United States.
          </p>
          <p class="text-xs font-mono text-slate-500">
            Central Dispatch: <a href="tel:+15712762316" class="text-amber-400 hover:underline">(571) 276-2316</a>
          </p>
        </div>

        <div>
          <h4 class="text-white font-bold text-sm tracking-wider uppercase font-mono mb-4">Regional Divisions</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="https://charterbusdc.onrender.com" class="hover:text-amber-400 transition-colors">Washington DC Diplomatic Protocol &rarr;</a></li>
            <li><a href="https://charterbusva.onrender.com" class="hover:text-amber-400 transition-colors">Virginia Military &amp; DoD Logistics &rarr;</a></li>
            <li><a href="https://charterbusmd.onrender.com" class="hover:text-amber-400 transition-colors">Maryland Casino &amp; Resort Shuttles &rarr;</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-bold text-sm tracking-wider uppercase font-mono mb-4">Ministry Services</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="#ministries" class="hover:text-white transition-colors">Youth Camps &amp; Retreats</a></li>
            <li><a href="#ministries" class="hover:text-white transition-colors">Gospel Choir &amp; Music Tours</a></li>
            <li><a href="#ministries" class="hover:text-white transition-colors">Denominational Conventions</a></li>
            <li><a href="#ministries" class="hover:text-white transition-colors">Mission Trips &amp; Volunteer Groups</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-bold text-sm tracking-wider uppercase font-mono mb-4">Safety &amp; Compliance</h4>
          <p class="text-sm text-slate-400 mb-3">
            All motorcoaches operate under full FMCSA and USDOT compliance with vetted, drug-tested commercial drivers, full liability coverage, and real-time GPS tracking.
          </p>
          <div class="p-3 rounded bg-slate-900 border border-slate-800 text-xs font-mono text-slate-300">
            Emergency &amp; Weekend Dispatch:<br>
            <span class="text-amber-400 font-bold">(571) 276-2316</span>
          </div>
        </div>
      </div>

      <div class="border-t border-slate-900 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <p>&copy; {new Date().getFullYear()} CharterBus Faith Network. All rights reserved.</p>
        <div class="flex items-center gap-6">
          <span>CharterBus Parent Hub</span>
          <span>&bull;</span>
          <span>FMCSA &bull; USDOT Compliant</span>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
