---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, any> | Record<string, any>[];
  ogType?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  schema,
  ogType = 'website'
} = Astro.props;

const canonicalUrl = canonical.endsWith('/') ? canonical : `${canonical}/`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="canonical" href={canonicalUrl}>
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="CharterBus MD - Casino &amp; Resort Nightlife Dispatch">

  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(schema) ? { "@context": "https://schema.org", "@graph": schema } : schema)} />
  )}
</head>
<body class="bg-white text-slate-900 antialiased selection:bg-purple-800 selection:text-white">
  <!-- Casino Dispatch Ribbon -->
  <div class="bg-slate-950 border-b border-slate-800 text-slate-300 text-xs py-2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">
          MARYLAND CASINO GROUP DESK
        </span>
        <span class="text-slate-400">MGM National Harbor, Live! Casino &amp; Horseshoe Baltimore VIP Charters</span>
      </div>
      <div class="flex items-center gap-4 text-xs font-mono">
        <span>VIP Casino Line: <a href="tel:+15712762316" class="text-purple-400 hover:text-purple-300 font-bold">(571) 276-2316</a></span>
        <span class="text-slate-600">|</span>
        <span class="text-slate-400">Direct Plateau Staging</span>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-purple-950 text-amber-400 flex items-center justify-center font-extrabold text-xl shadow-md border border-purple-800">
          MD
        </div>
        <div>
          <div class="font-extrabold text-xl tracking-tight text-slate-900 flex items-center gap-1.5 leading-none">
            CharterBus <span class="text-purple-700 text-xs font-mono font-bold uppercase tracking-wider px-1.5 py-0.5 bg-purple-50 border border-purple-200/60 rounded">Resort</span>
          </div>
          <p class="text-xs text-slate-500 mt-1 font-medium">Maryland Casino &amp; Nightlife Charter Dispatch</p>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
        <a href="#destinations" class="hover:text-purple-700 transition-colors">Casinos &amp; Resorts</a>
        <a href="#calculator" class="hover:text-purple-700 transition-colors">Casino Estimator</a>
        <a href="#operators" class="hover:text-purple-700 transition-colors">VIP Operator</a>
        <a href="#fleet" class="hover:text-purple-700 transition-colors">Luxury Fleet</a>
        <a href="#faq" class="hover:text-purple-700 transition-colors">Group FAQ</a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="tel:+15712762316" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-purple-800 hover:bg-purple-900 text-white font-semibold text-sm shadow-sm transition-all">
          (571) 276-2316
        </a>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="bg-slate-950 text-slate-400 py-16 border-t border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-purple-900 flex items-center justify-center text-white font-black text-sm">
              MD
            </div>
            <span class="font-bold text-white text-lg">CharterBus MD Resort</span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            Premier motorcoach service to Maryland's gaming resorts: MGM National Harbor, Live! Casino &amp; Hotel, and Horseshoe Baltimore.
          </p>
          <p class="text-xs font-mono text-slate-500">
            Casino Charter Desk: <a href="tel:+15712762316" class="text-purple-400 hover:underline">(571) 276-2316</a>
          </p>
        </div>

        <div>
          <h4 class="text-white font-bold text-sm tracking-wider uppercase font-mono mb-4">Maryland Destinations</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="#destinations" class="hover:text-purple-400 transition-colors">MGM National Harbor VIP Charters</a></li>
            <li><a href="#destinations" class="hover:text-purple-400 transition-colors">Live! Casino &amp; Hotel Arundel Mills</a></li>
            <li><a href="#destinations" class="hover:text-purple-400 transition-colors">Horseshoe Baltimore Entertainment</a></li>
            <li><a href="#destinations" class="hover:text-purple-400 transition-colors">The Theater at MGM Concert Shuttles</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-bold text-sm tracking-wider uppercase font-mono mb-4">CharterBus Network</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="https://charterbus.onrender.com" class="hover:text-purple-400 transition-colors">&larr; National Faith Parent Hub</a></li>
            <li><a href="https://charterbusdc.onrender.com" class="hover:text-purple-400 transition-colors">Washington DC Diplomatic &rarr;</a></li>
            <li><a href="https://charterbusva.onrender.com" class="hover:text-purple-400 transition-colors">Virginia Military Logistics &rarr;</a></li>
            <li><a href="/operators/vip-charter-bus-rentals/" class="text-purple-400 hover:underline">VIP Casino Operator Profile &rarr;</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-bold text-sm tracking-wider uppercase font-mono mb-4">VIP Group Perks</h4>
          <p class="text-sm text-slate-400 mb-3">
            Bypass individual parking fees, enjoy direct port-cochere drop-offs, and travel together in luxury leather seating with climate control.
          </p>
          <div class="p-3 rounded bg-slate-900 border border-slate-800 text-xs font-mono text-slate-300">
            Direct Casino Desk:<br>
            <span class="text-purple-400 font-bold">(571) 276-2316</span>
          </div>
        </div>
      </div>

      <div class="border-t border-slate-900 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <p>&copy; {new Date().getFullYear()} CharterBus Maryland Resort. All rights reserved.</p>
        <div class="flex items-center gap-6">
          <a href="/operators/vip-charter-bus-rentals/" class="hover:text-slate-400">Verified Casino Operator</a>
          <span>&bull;</span>
          <span>FMCSA &bull; MD PSC Certified</span>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
